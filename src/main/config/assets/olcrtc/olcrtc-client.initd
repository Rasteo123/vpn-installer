#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=04

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/olcrtc /etc/olcrtc/client.yaml
    procd_set_param user olcrtc
    procd_set_param respawn 10 30 5
    procd_set_param stderr 1
    procd_set_param stdout 1
    procd_close_instance
}
